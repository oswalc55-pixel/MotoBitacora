<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/historialFragment">

    <fragment
        android:id="@+id/historialFragment"
        android:name="com.example.motobitacora.ui.historial.HistorialFragment"
        android:label="@string/titulo_historial" />

    <fragment
        android:id="@+id/formularioFragment"
        android:name="com.example.motobitacora.ui.formulario.FormularioFragment"
        android:label="@string/titulo_formulario">
        <argument
            android:name="registroId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/resumenFragment"
        android:name="com.example.motobitacora.ui.resumen.ResumenFragment"
        android:label="@string/titulo_resumen" />

    <fragment
        android:id="@+id/motoFragment"
        android:name="com.example.motobitacora.ui.moto.MotoFragment"
        android:label="@string/titulo_moto" />
</navigation>